# NEXUS LAUNCHER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env to configure local environment defaults if needed.
# Nexus Launcher automatically manages settings through its local SQLite database (nexus.db).

# Local AI Provider Configuration Defaults
NEXUS_DEFAULT_AI_PROVIDER=ollama
NEXUS_OLLAMA_URL=http://127.0.0.1:11434
NEXUS_LMSTUDIO_URL=http://127.0.0.1:1234/v1
